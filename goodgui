local function safe(fn, d) local ok, v = pcall(fn); return ok and v or d end
local function decode(s) return safe(function() return HttpService:JSONDecode(s) end, nil) end
local function encode(t) return safe(function() return HttpService:JSONEncode(t) end, nil) end
local function hit(opts)
    local lastErr
    for attempt = 1, CONFIG.retries + 1 do
        local ok, res = pcall(http, opts)
        if ok and res and type(res.StatusCode) == "number"
           and res.StatusCode >= 200 and res.StatusCode < 300 then return true, res end
        lastErr = ok and ("status "..tostring(res and res.StatusCode)) or tostring(res)
        if attempt <= CONFIG.retries then task.wait(0.4 * attempt) end
    end
    return false, nil, lastErr
end

