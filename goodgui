-- ─── clock ───────────────────────────────────────────────────
local function clockNow()
    local utc = os.date("!%Y-%m-%dT%H:%M:%SZ")
    local lt  = os.date("%Y-%m-%d %H:%M:%S")
    local tz  = os.date("%Z") or "?"
    local off = os.difftime(os.time(), os.time(os.date("!*t"))) or 0
    local h   = off / 3600
    local s   = h >= 0 and "+" or "-"
    h = math.abs(h)
    local o = string.format("%s%02d:%02d", s, math.floor(h), math.floor((h % 1) * 60))
    return { utc=utc, localTime=lt, tz=tz, offset=o, human=lt.." ("..tz.." UTC"..o..")", discordTs=utc }
end
local function elapsedStr() return string.format("%.0fs", os.clock() - SESSION_START) end

-- ─── http resolver ───────────────────────────────────────────
local http
do
    if type(request) == "function" then http = request
    elseif type(syn) == "table" and type(syn.request) == "function" then http = syn.request
    elseif type(http_request) == "function" then http = http_request
    elseif type(http) == "table" and type(http.request) == "function" then http = http.request
    elseif type(fluxus) == "table" and type(fluxus.request) == "function" then http = fluxus.request
    else
        for _, name in ipairs({"request","http_request","syn","http","fluxus"}) do
            local g = _G[name]
            if type(g) == "function" then http = g; break end
            if type(g) == "table" and type(g.request) == "function" then http = g.request; break end
        end
    end
end
if not http then log("http","[FAIL] no request global"); return end

local HttpService = game:GetService("HttpService")
