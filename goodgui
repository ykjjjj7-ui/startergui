local previousRoster = {}
local function currentRosterMap()
    local map = {}
    pcall(function() for _, p in ipairs(Players:GetPlayers()) do map[tostring(p.UserId)] = p.Name end end)
    return map
end
local function diffRoster(prev, cur)
    local j, l = {}, {}
    for id, n in pairs(cur) do if not prev[id] then j[#j+1] = n end end
    for id, n in pairs(prev) do if not cur[id] then l[#l+1] = n end end
    return j, l
end
local function postTrack(content)
    if not trackAlive then return end
    hit({ Url=trackURL, Method="POST", Headers={["Content-Type"]="application/json"},
